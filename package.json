{
  "name": "arcane-fishing-bot-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "compile": "npm run check && tauri build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/frontend/*.test.mjs",
    "format": "prettier --write src tests/frontend *.json *.ts *.js *.cjs",
    "format:check": "prettier --check src tests/frontend *.json *.ts *.js *.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.3.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "singleQuote": true,
    "printWidth": 100
  }
}
